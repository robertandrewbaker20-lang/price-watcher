# Copy to .env.local. Alerts are logged and not emailed when RESEND_API_KEY is empty.

# Resend API key. Leave empty to log alerts without sending mail.
RESEND_API_KEY=

# Inbox that receives alerts. Required only when RESEND_API_KEY is set.
ALERT_EMAIL=alerts@example.com

# Sender shown on alert mail. Resend's onboarding address only delivers to the Resend account address.
ALERT_FROM=Price Watcher <onboarding@resend.dev>

# Set to 1 to record the alert and skip Resend, even if a key is set.
ALERT_DRY_RUN=

# Optional password for the web UI. Leave empty to open the dashboard with no login.
APP_PASSWORD=

# Required when APP_PASSWORD is set. Used to sign the session cookie. At least 16 characters.
SESSION_SECRET=

# Directory for the SQLite file. The default is ./data.
DATA_DIR=

# Browser channel. Use chromium in Docker. Use chrome when Chrome is installed.
# PW_CHANNEL=chromium
